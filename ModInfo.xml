<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<mod unique="PaxSporeanaLivingGalaxy4X"
     displayName="Pax Sporeana: Living Galaxy 4X"
     description="Unified 4X Grand Strategy Overhaul: Player Garrisons, AI Treasuries, 3D Trade Convoys, 10 Philosophy Doctrines, Cluster Colonization, Terraforming &amp; Breakaway Revolutions. Requires UPE."
     installerSystemVersion="1.0.1.2"
     hasCustomInstaller="true"
     dllsBuild="$SPOREMOD_DLLS_BUILD"
     isExperimental="$SPOREMOD_EXPERIMENTAL">

    <!-- Ядро единого мода -->
    <prerequisite>PaxSporeana4X.dll</prerequisite>
    <prerequisite game="GalacticAdventures">Space-Diplomacy-Overhaul_Main.package</prerequisite>
    <prerequisite game="GalacticAdventures">Space-Warfare-Overhaul_Main.package</prerequisite>
    <prerequisite game="GalacticAdventures">SensibleAIColonization_Main.package</prerequisite>
    <prerequisite game="GalacticAdventures">Space-Diplomacy-Overhaul_SaicPatch_Config.package</prerequisite>

    <!-- Очистка при переустановке -->
    <remove>PaxSporeana4X.dll</remove>
    <remove>Defensive Ships In Player Colonies.dll</remove>
    <remove>Ai Empire Diplomacy War.dll</remove>
    <remove>Ai Empire Colonization.dll</remove>
    <remove game="GalacticAdventures">*Space-Diplomacy-Overhaul*.package</remove>
    <remove game="GalacticAdventures">*Space-Warfare-Overhaul*.package</remove>
    <remove game="GalacticAdventures">*Sensible*Colonization*.package</remove>
    <remove game="GalacticAdventures">Fleet_*.package</remove>
    <remove game="GalacticAdventures">Rebel_*.package</remove>
    <remove game="GalacticAdventures">Upkeep_*.package</remove>
    <remove game="GalacticAdventures">Unrest_*.package</remove>
    <remove game="GalacticAdventures">Gadget_*.package</remove>
    <remove game="GalacticAdventures">Trade_*.package</remove>

    <!-- Радиус симуляции + Центр радиуса + Защита сохранений -->
    <componentGroup unique="PaxActiveRadiusGroup" displayName="Active Radius">
        <component game="GalacticAdventures" unique="PaxRadius40" displayName="40 pc (Best FPS)" description="Simulates diplomacy, wars, trade, and colonization within 40 pc.">Space-Diplomacy-Overhaul_40Radius_Config.package
SensibleAIColonization_40Radius_Config.package</component>
        <component game="GalacticAdventures" unique="PaxRadius60" displayName="60 pc" description="Simulates diplomacy, wars, trade, and colonization within 60 pc.">Space-Diplomacy-Overhaul_60Radius_Config.package
SensibleAIColonization_60Radius_Config.package</component>
        <component game="GalacticAdventures" unique="PaxRadius100" displayName="100 pc (Default)" description="Balanced 4X sector scale within 100 parsecs." defaultChecked="true">Space-Diplomacy-Overhaul_100Radius_Config.package
SensibleAIColonization_100Radius_Config.package</component>
        <component game="GalacticAdventures" unique="PaxRadius200" displayName="200 pc (Massive)" description="Simulates empires within 200 parsecs (High CPU).">Space-Diplomacy-Overhaul_200Radius_Config.package
SensibleAIColonization_200Radius_Config.package</component>
    </componentGroup>

    <componentGroup unique="Space-Diplomacy-Overhaul_ActiveRangeReference_Config" displayName="Active Range Center">
        <component game="GalacticAdventures" unique="SpaceDiplomacyAndWarOverhaul_HomeworldActiveRangeReference_Config" displayName="Homeworld" description="Uses the player's homeworld as the center of the active range." defaultChecked="true">Space-Diplomacy-Overhaul_HomeworldActiveRangeReference_Config.package</component>
        <component game="GalacticAdventures" unique="SpaceDiplomacyAndWarOverhaul_CurrentPositionActiveRangeReference_Config" displayName="Current Position" description="Uses the player's current position as the center of the active range.">Space-Diplomacy-Overhaul_CurrentPositionActiveRangeReference_Config.package</component>
    </componentGroup>

    <componentGroup unique="Space-Diplomacy-Overhaul_EmpireInvalidationDepth_Config" displayName="Player Exclusion Depth">
        <component game="GalacticAdventures" unique="SpaceDiplomacyAndWarOverhaul_OnlyPlayersInvalidationDepth_Config" displayName="Players Only" description="Ignores only other save-file player empires.">Space-Diplomacy-Overhaul_OnlyPlayersInvalidationDepth_Config.package</component>
        <component game="GalacticAdventures" unique="SpaceDiplomacyAndWarOverhaul_DirectRelationsInvalidationDepth_Config" displayName="Players + Direct" description="Ignores other players' empires and their direct allies and enemies." defaultChecked="true">Space-Diplomacy-Overhaul_DirectRelationsInvalidationDepth_Config.package</component>
        <component game="GalacticAdventures" unique="SpaceDiplomacyAndWarOverhaul_IndirectRelationsInvalidationDepth_Config" displayName="Players + Indirect" description="Ignores other players' empires, direct relations, and secondary relations.">Space-Diplomacy-Overhaul_IndirectRelationsInvalidationDepth_Config.package</component>
    </componentGroup>

    <componentGroup unique="FleetScalingGroup" displayName="Fleet Scaling">
        <component game="GalacticAdventures" unique="Fleet_02x" displayName="Minimal (0.2x)" description="Lightweight garrisons (10-15 vessels max) for low-end PCs.">Fleet_02x.package</component>
        <component game="GalacticAdventures" unique="Fleet_05x" displayName="Low (0.5x)" description="Small task forces (up to 25 vessels) with minimal performance impact.">Fleet_05x.package</component>
        <component game="GalacticAdventures" unique="Fleet_10x" displayName="Normal (1.0x)" description="Balanced 4X gameplay: dynamic Soft-Cap scaling with T-Score, Unlimited-Colony cities, stars, and weaponry rank." defaultChecked="true">Fleet_10x.package</component>
        <component game="GalacticAdventures" unique="Fleet_13x" displayName="Reinforced (1.3x)" description="Fortified orbital garrisons (up to 65 vessels on developed hubs).">Fleet_13x.package</component>
        <component game="GalacticAdventures" unique="Fleet_15x" displayName="Ultra (1.5x)" description="Massive sector armadas for high-end systems and intense planetary sieges.">Fleet_15x.package</component>
    </componentGroup>

    <componentGroup unique="GalacticTradeGroup" displayName="Galactic Trade &amp; Convoys">
        <component game="GalacticAdventures" unique="Trade_00x" displayName="Disabled (0.0x)" description="Disables dynamic AI trade networks, spice arbitrage profits, war deterrence, and 3D orbital cargo convoys.">Trade_00x.package</component>
        <component game="GalacticAdventures" unique="Trade_05x" displayName="Modest (0.5x)" description="Conservative trade income, compact 3D freighter wings, and up to 3 base routes per empire.">Trade_05x.package</component>
        <component game="GalacticAdventures" unique="Trade_10x" displayName="Standard (1.0x)" description="Living spaceports: two-way player &amp; multi-species 3D convoys, convoy plundering, war shock, and 5 base routes per empire." defaultChecked="true">Trade_10x.package</component>
        <component game="GalacticAdventures" unique="Trade_15x" displayName="Booming (1.5x)" description="Bustling galactic hubs: dense 3D cargo fleets, high-yield rare spice arbitrage, and up to 8 base routes per empire.">Trade_15x.package</component>
    </componentGroup>

    <componentGroup unique="FleetUpkeepGroup" displayName="Fleet Upkeep">
        <component game="GalacticAdventures" unique="Upkeep_00x" displayName="Disabled (0.0x)" description="Free peacetime garrisons with zero periodic Sporebuck maintenance costs.">Upkeep_00x.package</component>
        <component game="GalacticAdventures" unique="Upkeep_05x" displayName="Low (0.5x)" description="Light payroll every 4 minutes; high local spice self-sufficiency for player and AI treasuries.">Upkeep_05x.package</component>
        <component game="GalacticAdventures" unique="Upkeep_10x" displayName="Standard (1.0x)" description="Balanced maintenance every 3 minutes; rare spices and trade offset garrison expenses." defaultChecked="true">Upkeep_10x.package</component>
        <component game="GalacticAdventures" unique="Upkeep_20x" displayName="Hardcore (2.0x)" description="Strict military budget every 2 minutes; overextended empires without trade risk bankruptcy fast.">Upkeep_20x.package</component>
    </componentGroup>

    <componentGroup unique="ColonialRebellionsGroup" displayName="Rebellions &amp; Secessions">
        <component game="GalacticAdventures" unique="Rebellion_Disabled" displayName="Disabled (0.0x)" description="100% loyal fleets: disables player/AI garrison mutinies, Zealot Schisms, and background star secessions.">Rebel_00x.package</component>
        <component game="GalacticAdventures" unique="Rebellion_Low" displayName="Stable (0.5x)" description="Mild unrest: rare mutinies, shorter 120s Zealot Schisms, and breakaway republics only in 8+ star bankrupt empires.">Rebel_05x.package</component>
        <component game="GalacticAdventures" unique="Rebellion_Enabled" displayName="Standard (1.0x)" description="Full 4X politics: mutinies from bankruptcy/losses, 240s Zealot Schism cascades, SOS alerts, and secessions in 6+ star giants." defaultChecked="true">Rebel_10x.package</component>
        <component game="GalacticAdventures" unique="Rebellion_Anarchy" displayName="Anarchy (2.0x)" description="Volatile galaxy: double mutiny rates, 360s Zealot Schisms, frequent SOS uprisings, and breakaway republics from 5+ star empires.">Rebel_20x.package</component>
    </componentGroup>

    <componentGroup unique="CityUnrestGroup" displayName="City Unrest Impact">
        <component game="GalacticAdventures" unique="Unrest_00x" displayName="Ignored (0.0x)" description="Unhappy citizens and excess factories never slow down shipyards or provoke strikes.">Unrest_00x.package</component>
        <component game="GalacticAdventures" unique="Unrest_05x" displayName="Mild (0.5x)" description="Minor shipyard slowdowns and low strike pressure from unhappy industrial cities.">Unrest_05x.package</component>
        <component game="GalacticAdventures" unique="Unrest_10x" displayName="Standard (1.0x)" description="Factory sweatshops and blockades slow shipyards and spark Scientist/Ecologist wartime strikes." defaultChecked="true">Unrest_10x.package</component>
        <component game="GalacticAdventures" unique="Unrest_20x" displayName="Volatile (2.0x)" description="Neglected factory colonies rapidly erupt into shipyard paralysis and orbital mutinies.">Unrest_20x.package</component>
    </componentGroup>

    <componentGroup unique="ColonyGadgetsGroup" displayName="Colony Gadgets &amp; Lore">
        <component game="GalacticAdventures" unique="Gadget_00x" displayName="Vanilla (0.0x)" description="Disables custom gadget synergies, Uber-Dreadnoughts, Embassies, Shaman Astral Wardens/Rebirth, and Ecologist Bio-Regen.">Gadget_00x.package</component>
        <component game="GalacticAdventures" unique="Gadget_05x" displayName="Moderate (0.5x)" description="Half-strength bonuses for planetary buildings, riot-control tools, Shaman portals, and Ecologist regeneration.">Gadget_05x.package</component>
        <component game="GalacticAdventures" unique="Gadget_10x" displayName="Standard (1.0x)" description="Full 4X synergy: Spice Depots, Uber-Dreadnoughts, Embassies, Shaman Astral Nexus &amp; Rebirth, Ecologist Bio-Regen &amp; Necrosis." defaultChecked="true">Gadget_10x.package</component>
        <component game="GalacticAdventures" unique="Gadget_15x" displayName="Amplified (1.5x)" description="Maximum tactical impact from colonization buildings, ship siege tools, and philosophy lore abilities.">Gadget_15x.package</component>
    </componentGroup>

