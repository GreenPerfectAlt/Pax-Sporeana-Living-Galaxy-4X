<mod xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     displayName="Pax Sporeana: Living Galaxy 4X"
     unique="PaxSporeanaLivingGalaxy4X"
     description="Unified 4X Grand Strategy Overhaul: AI Treasuries, 3D Trade Convoys, Player Garrisons, Cluster Colonization, Terraforming, Philosophy Lore &amp; Breakaway Revolutions."
     installerSystemVersion="1.0.1.2"
     hasCustomInstaller="true"
     dllsBuild="$SPOREMOD_DLLS_BUILD"
     isExperimental="$SPOREMOD_EXPERIMENTAL">

    <!-- Авто-очистка старых раздельных модов при переходе на Pax Sporeana -->
    <remove game="GalacticAdventures">*Defensive*Ships*.dll</remove>
    <remove game="GalacticAdventures">*Ai*Empire*Diplomacy*.dll</remove>
    <remove game="GalacticAdventures">*Sensible*Colonization*.dll</remove>
    <remove game="GalacticAdventures">*Ai*Colonization*.dll</remove>
    <remove game="DataEP1">*Space*Diplomacy*Overhaul*.package</remove>
    <remove game="DataEP1">*Space*Warfare*Overhaul*.package</remove>
    <remove game="DataEP1">*Sensible*Colonization*.package</remove>
    <remove game="DataEP1">Fleet_*.package</remove>
    <remove game="DataEP1">Rebel_*.package</remove>
    <remove game="DataEP1">Rebellion_*.package</remove>
    <remove game="DataEP1">Upkeep_*.package</remove>
    <remove game="DataEP1">Unrest_*.package</remove>
    <remove game="DataEP1">Gadget_*.package</remove>
    <remove game="DataEP1">Trade_*.package</remove>

    <!-- Обязательное ядро единого мода -->
    <prerequisite game="GalacticAdventures">PaxSporeana4X.dll</prerequisite>
    <prerequisite game="DataEP1">Space Diplomacy Overhaul.package</prerequisite>
    <prerequisite game="DataEP1">SpaceWarfareOverhaul_Main.package</prerequisite>
    <prerequisite game="DataEP1">Sensible Ai Colonization.package</prerequisite>
    <prerequisite game="DataEP1">Space-Diplomacy-Overhaul_SaicPatch_Config.package</prerequisite>
    <prerequisite game="DataEP1">Space-Diplomacy-Overhaul_CurrentPositionActiveRangeReference_Config.package</prerequisite>
    <prerequisite game="DataEP1">Space-Diplomacy-Overhaul_DirectRelationsInvalidationDepth_Config.package</prerequisite>

    <!-- 1. ЕДИНЫЙ РАДИУС СИМУЛЯЦИИ (Войны + Дипломатия + Торговля + Колонизация) -->
    <componentGroup unique="PaxActiveRadiusGroup" displayName="1. Galaxy Simulation Active Radius">
        <component unique="PaxRadius40" displayName="Compact (40 pc) - Best FPS for low-end PCs">
            <file game="DataEP1">Space-Diplomacy-Overhaul_40Radius_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_40Radius_Config.package</file>
        </component>
        <component unique="PaxRadius60" displayName="Standard (60 pc) - Balanced performance &amp; scale" defaultChecked="true">
            <file game="DataEP1">Space-Diplomacy-Overhaul_60Radius_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_60Radius_Config.package</file>
        </component>
        <component unique="PaxRadius100" displayName="Wide Sector (100 pc) - Large frontlines">
            <file game="DataEP1">Space-Diplomacy-Overhaul_100Radius_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_100Radius_Config.package</file>
        </component>
        <component unique="PaxRadius200" displayName="Galactic Arm (200 pc) - Massive simulation (High CPU)">
            <file game="DataEP1">Space-Diplomacy-Overhaul_200Radius_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_200Radius_Config.package</file>
        </component>
    </componentGroup>

    <!-- 2. ГАРНИЗОНЫ КОЛОНИЙ ИГРОКА (Fleet_02x .. Fleet_15x) -->
    <componentGroup unique="FleetScalingGroup" displayName="2. Planetary Garrison Fleet Scale">
        <component unique="Fleet_02x" displayName="Minimal (0.2x) - Lightweight patrols">
            <file game="DataEP1">Fleet_02x.package</file>
        </component>
        <component unique="Fleet_05x" displayName="Low (0.5x) - Small task forces">
            <file game="DataEP1">Fleet_05x.package</file>
        </component>
        <component unique="Fleet_10x" displayName="Standard (1.0x) - Balanced 4X garrisons" defaultChecked="true">
            <file game="DataEP1">Fleet_10x.package</file>
        </component>
        <component unique="Fleet_13x" displayName="Reinforced (1.3x) - Heavy sector bastions">
            <file game="DataEP1">Fleet_13x.package</file>
        </component>
        <component unique="Fleet_15x" displayName="Ultra Armada (1.5x) - Massive orbital battles">
            <file game="DataEP1">Fleet_15x.package</file>
        </component>
    </componentGroup>

    <!-- 3. ГАЛАКТИЧЕСКАЯ ТОРГОВЛЯ И КОНВОИ (Trade_00x .. Trade_15x) -->
    <componentGroup unique="TradeGroup" displayName="3. Galactic Trade &amp; 3D Convoys">
        <component unique="Trade_00x" displayName="Disabled (0.0x) - Vanilla trade only">
            <file game="DataEP1">Trade_00x.package</file>
        </component>
        <component unique="Trade_05x" displayName="Light (0.5x) - Modest routes &amp; small convoys">
            <file game="DataEP1">Trade_05x.package</file>
        </component>
        <component unique="Trade_10x" displayName="Standard (1.0x) - Multi-species spaceports &amp; spice arbitrage" defaultChecked="true">
            <file game="DataEP1">Trade_10x.package</file>
        </component>
        <component unique="Trade_15x" displayName="Booming (1.5x) - Dense 8-route trade hubs &amp; rich plunder">
            <file game="DataEP1">Trade_15x.package</file>
        </component>
    </componentGroup>

    <!-- 4. КАЗНА И ЖАЛОВАНИЕ ФЛОТА (Upkeep_00x .. Upkeep_20x) -->
    <componentGroup unique="UpkeepGroup" displayName="4. Imperial Treasury &amp; Fleet Upkeep">
        <component unique="Upkeep_00x" displayName="Disabled (0.0x) - Free fleets, no treasury scaling">
            <file game="DataEP1">Upkeep_00x.package</file>
        </component>
        <component unique="Upkeep_05x" displayName="Relaxed (0.5x) - Low maintenance costs">
            <file game="DataEP1">Upkeep_05x.package</file>
        </component>
        <component unique="Upkeep_10x" displayName="Standard (1.0x) - Balanced 4X upkeep &amp; inflation" defaultChecked="true">
            <file game="DataEP1">Upkeep_10x.package</file>
        </component>
        <component unique="Upkeep_20x" displayName="Hardcore (2.0x) - Strict military economy">
            <file game="DataEP1">Upkeep_20x.package</file>
        </component>
    </componentGroup>

    <!-- 5. РЕВОЛЮЦИИ, СХИЗМА И РЕСПУБЛИКИ (Rebel_00x .. Rebel_20x) -->
    <componentGroup unique="RebellionGroup" displayName="5. Rebellions, Schisms &amp; Secession">
        <component unique="Rebel_00x" displayName="Disabled (0.0x) - 100% loyal fleets &amp; empires">
            <file game="DataEP1">Rebel_00x.package</file>
        </component>
        <component unique="Rebel_05x" displayName="Low (0.5x) - Rare frontier revolts">
            <file game="DataEP1">Rebel_05x.package</file>
        </component>
        <component unique="Rebel_10x" displayName="Standard (1.0x) - Breakaway republics &amp; Great Schism" defaultChecked="true">
            <file game="DataEP1">Rebel_10x.package</file>
        </component>
        <component unique="Rebel_20x" displayName="Anarchy (2.0x) - Frequent galactic civil wars">
            <file game="DataEP1">Rebel_20x.package</file>
        </component>
    </componentGroup>

    <!-- 6. ЗАБАСТОВКИ ГОРОДОВ (Unrest_00x .. Unrest_20x) -->
    <componentGroup unique="UnrestGroup" displayName="6. City Strikes &amp; Factory Unrest">
        <component unique="Unrest_00x" displayName="Disabled (0.0x) - No factory strikes">
            <file game="DataEP1">Unrest_00x.package</file>
        </component>
        <component unique="Unrest_05x" displayName="Mild (0.5x) - Forgiving city happiness">
            <file game="DataEP1">Unrest_05x.package</file>
        </component>
        <component unique="Unrest_10x" displayName="Standard (1.0x) - Balanced factory vs entertainment" defaultChecked="true">
            <file game="DataEP1">Unrest_10x.package</file>
        </component>
        <component unique="Unrest_20x" displayName="Volatile (2.0x) - Severe industrial strikes">
            <file game="DataEP1">Unrest_20x.package</file>
        </component>
    </componentGroup>

    <!-- 7. ЛОР ФИЛОСОФИЙ И ПЛАНЕТАРНЫЕ ГАДЖЕТЫ (Gadget_00x .. Gadget_15x) -->
    <componentGroup unique="GadgetGroup" displayName="7. Philosophy Lore &amp; Colony Gadgets">
        <component unique="Gadget_00x" displayName="Vanilla (0.0x) - Disable custom gadget &amp; lore effects">
            <file game="DataEP1">Gadget_00x.package</file>
        </component>
        <component unique="Gadget_05x" displayName="Subtle (0.5x) - Moderate gadget &amp; biosphere scaling">
            <file game="DataEP1">Gadget_05x.package</file>
        </component>
        <component unique="Gadget_10x" displayName="Standard (1.0x) - Full Dreadnoughts, Shaman &amp; Ecologist Lore" defaultChecked="true">
            <file game="DataEP1">Gadget_10x.package</file>
        </component>
        <component unique="Gadget_15x" displayName="Amplified (1.5x) - Maximum tactical &amp; lore asymmetry">
            <file game="DataEP1">Gadget_15x.package</file>
        </component>
    </componentGroup>

    <!-- 8. ЭКСПАНСИЯ И КОЛОНИЗАЦИЯ ИИ -->
    <componentGroup unique="ColonizationSpeedGroup" displayName="8. AI Cluster Colonization Speed">
        <component unique="ColSpeedSlow" displayName="Slow Expansion">
            <file game="DataEP1">SensibleAIColonization_SlowSpeed_Config.package</file>
        </component>
        <component unique="ColSpeedNormal" displayName="Normal Expansion (Recommended)" defaultChecked="true">
            <file game="DataEP1">SensibleAIColonization_NormalSpeed_Config.package</file>
        </component>
        <component unique="ColSpeedFast" displayName="Fast Expansion">
            <file game="DataEP1">SensibleAIColonization_FastSpeed_Config.package</file>
        </component>
        <component unique="ColSpeedVeryFast" displayName="Very Fast Expansion">
            <file game="DataEP1">SensibleAIColonization_VeryFastSpeed_Config.package</file>
        </component>
    </componentGroup>

    <!-- 9. ТЕРРАФОРМИРОВАНИЕ ИИ -->
    <componentGroup unique="TerraformingGroup" displayName="9. AI Terraforming Behavior">
        <component unique="TerraformNone" displayName="Disabled - AI never terraforms">
            <file game="DataEP1">SensibleAIColonization_NoTerraforming_Config.package</file>
        </component>
        <component unique="TerraformBalanced" displayName="Balanced - Green orbits &amp; good spice (Recommended)" defaultChecked="true">
            <file game="DataEP1">SensibleAIColonization_GreenOrbitGoodSpiceTerraforming_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_NormalTerraformingSpeed_Config.package</file>
        </component>
        <component unique="TerraformAggressive" displayName="Aggressive - All planets &amp; fast terraforming">
            <file game="DataEP1">SensibleAIColonization_AllPlanetsTerraforming_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_FastTerraformingSpeed_Config.package</file>
        </component>
    </componentGroup>

    <!-- 10. ВНУТРИСИСТЕМНАЯ КОЛОНИЗАЦИЯ И РАСШИРЕНИЕ ИГРОКА -->
    <componentGroup unique="IntraSystemColonizationGroup" displayName="10. Intra-System Colonization &amp; Player Expansion">
        <component unique="IntraHabitableRestricted" displayName="Habitable Planets Only - Player expansion restricted" defaultChecked="true">
            <file game="DataEP1">SensibleAiColonization_OnlyHabitablePlanetsIntraSystemColonization_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_BasedOnEmpireArchetypePreSpaceColonizationRule_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_DisabledPlayerExpansion_Config.package</file>
        </component>
        <component unique="IntraAllRestricted" displayName="All Planets - Player expansion restricted">
            <file game="DataEP1">SensibleAiColonization_AllPlanetsIntraSystemColonization_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_BasedOnEmpireArchetypePreSpaceColonizationRule_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_DisabledPlayerExpansion_Config.package</file>
        </component>
        <component unique="IntraHabitableEnabled" displayName="Habitable Planets Only - Player expansion enabled">
            <file game="DataEP1">SensibleAiColonization_OnlyHabitablePlanetsIntraSystemColonization_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_BasedOnEmpireArchetypePreSpaceColonizationRule_Config.package</file>
            <file game="DataEP1">SensibleAIColonization_EnabledPlayerExpansion_Config.package</file>
        </component>
    </componentGroup>

    <!-- 11. ВОЕННАЯ ДОКТРИНА И ДИПЛОМАТИЧЕСКИЙ БАЛАНС -->
    <componentGroup unique="WarfareDoctrineGroup" displayName="11. Galactic Warfare &amp; Diplomacy Doctrine">
        <component unique="WarPeaceful" displayName="Peaceful Frontier - Low aggressiveness, fewer AI bombers">
            <file game="DataEP1">Space-Diplomacy-Overhaul_LowAgressiveness_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_0.50AIBomberProductionRate_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_RebalancedCombatSpaceBalancing_Module.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_IntendedEffects_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_BuffWarriorsZealots_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_HighBuffHostileArchetypes_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_75PlayerBomberCost_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_WarNotificationsAlliesAndEnemies_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceNotificationsAlliesAndEnemies_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceBreakNotificationsAlliesAndEnemies_Config.package</file>
        </component>
        <component unique="WarStandard" displayName="Standard 4X Balance (Recommended)" defaultChecked="true">
            <file game="DataEP1">Space-Diplomacy-Overhaul_NormalAgressiveness_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_1AIBomberProductionRate_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_RebalancedCombatSpaceBalancing_Module.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_IntendedEffects_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_BuffWarriorsZealots_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_HighBuffHostileArchetypes_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_75PlayerBomberCost_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_WarNotificationsAlliesAndEnemies_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceNotificationsAlliesAndEnemies_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceBreakNotificationsAlliesAndEnemies_Config.package</file>
        </component>
        <component unique="WarTotal" displayName="Total Galactic War - High aggressiveness, extreme hostile buffs">
            <file game="DataEP1">Space-Diplomacy-Overhaul_HighAgressiveness_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_1.5AIBomberProductionRate_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_RebalancedCombatSpaceBalancing_Module.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_IntendedEffects_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_BuffWarriorsZealots_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_ExtremeBuffHostileArchetypes_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_100PlayerBomberCost_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_WarNotificationsAll_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceNotificationsAlliesAndEnemies_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceBreakNotificationsAlliesAndEnemies_Config.package</file>
        </component>
        <component unique="WarVanillaCombat" displayName="Vanilla Combat Balance - Standard diplomacy with vanilla ship stats">
            <file game="DataEP1">Space-Diplomacy-Overhaul_NormalAgressiveness_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_1AIBomberProductionRate_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_VanillaCombatSpaceBalancing_Module.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_IntendedEffects_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_BuffWarriorsZealots_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_HighBuffHostileArchetypes_Config.package</file>
            <file game="DataEP1">Space-Warfare-Overhaul_75PlayerBomberCost_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_WarNotificationsAlliesAndEnemies_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceNotificationsAlliesAndEnemies_Config.package</file>
            <file game="DataEP1">Space-Diplomacy-Overhaul_AllianceBreakNotificationsAlliesAndEnemies_Config.package</file>
        </component>
    </componentGroup>

</mod>
