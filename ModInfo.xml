        <component game="GalacticAdventures" unique="SensibleAIColonization_ExtremelySlowSpeed_Config" displayName="Extremely Slow" description="On average, empires will take 5 hours to reach 13 systems.">SensibleAIColonization_ExtremelySlowSpeed_Config.package</component>
        <component game="GalacticAdventures" unique="SensibleAIColonization_VerySlowSpeed_Config" displayName="Very Slow" description="On average, empires will take 3 hours to reach 13 systems.">SensibleAIColonization_VerySlowSpeed_Config.package</component>
        <component game="GalacticAdventures" unique="SensibleAIColonization_SlowSpeed_Config" displayName="Slow" description="On average, empires will take 2 hours to reach 13 systems.">SensibleAIColonization_SlowSpeed_Config.package</component>
        <component game="GalacticAdventures" unique="SensibleAIColonization_NormalSpeed_Config" displayName="Normal (Default)" description="On average, empires will take 1 hour and 30 minutes to reach 13 systems." defaultChecked="true">SensibleAIColonization_NormalSpeed_Config.package</component>
        <component game="GalacticAdventures" unique="SensibleAIColonization_FastSpeed_Config" displayName="Fast" description="On average, empires will take 1 hour to reach 13 systems.">SensibleAIColonization_FastSpeed_Config.package</component>
        <component game="GalacticAdventures" unique="SensibleAIColonization_VeryFastSpeed_Config" displayName="Very Fast" description="On average, empires will take 40 minutes to reach 13 systems.">SensibleAIColonization_VeryFastSpeed_Config.package</component>
        <component game="GalacticAdventures" unique="SensibleAIColonization_ExtremelyFastSpeed_Config" displayName="Extremely Fast" description="On average, empires will take 30 minutes to reach 13 systems.">SensibleAIColonization_ExtremelyFastSpeed_Config.package</component>
    </componentGroup>

